          {"name": "halo_centre", "icons": []},
          {"name": "top_right", "icons": []},
          {"name": "bottom_right", "icons": [{"op": "power", "n": 1, "target": "self"}]},
          {"name": "bottom_left", "icons": []},
          {"name": "top_left", "icons": [{"op": "power", "n": 1, "target": "partner"}]}
