# Example environment variables — placeholders only. NEVER commit real secrets.
#
# Nothing in this repo auto-loads a .env file (there is no python-dotenv). These
# vars are read straight from the process environment, so in practice you set them
# in the deploy platform: the BACKEND vars in the Render dashboard, the VITE_* vars
# as build env for the GitHub Pages / Vite build. This file just documents what the
# app actually reads. Copy to .env for local use if your shell sources it (.env is
# gitignored); unset vars fall back to the defaults shown in the comments.

# ── Backend (FastAPI / Render) ───────────────────────────────────────────────
# Admin/owner identity: the username treated as SITE_OWNER (admin on every path).
SITE_OWNER=your-username

# Persistence. If TURSO_DATABASE_URL is set the app uses Turso/libSQL (prod, so data
# survives Render's ephemeral disk); otherwise it uses local sqlite and, on any Turso
# failure, falls back to local sqlite automatically. TURSO_AUTH_TOKEN is a SECRET.
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-token
# Optional: override the local sqlite path (default: games/spender/users.db).
SITE_DB_PATH=

# Extra CORS origins, comma-separated. MERGED with the always-on defaults (the Pages
# site, the Cloudflare staging worker, localhost) — it does not replace them.
CORS_ALLOWED_ORIGINS=https://your-extra-origin.example

# ── Frontend build (Vite — baked in at build time, not runtime) ───────────────
# WebSocket backend URL the built client connects to (prod value shown as example).
VITE_WS_URL=wss://splendid-nelz.onrender.com/ws
# Base path: "/" for a root/staging host, "/repo-name/" for a GitHub Pages project site.
VITE_BASE=/

# ── WWSD sub-service (the external-Splendor autoplayer; optional) ─────────────
# Only needed if you run the wwsd service. WWSD_SECRET is a SECRET; the rest are tuning.
WWSD_SECRET=your-wwsd-secret
WWSD_ORIGIN=https://spendee.mattle.online
WWSD_TIME=3.5
WWSD_TIME_MIN=1
WWSD_TIME_MAX=60
WWSD_RATE_MAX=20
WWSD_RATE_WINDOW=60

# ── Optional Spender AI model overrides ───────────────────────────────────────
# Advanced: point the served brain at alternate model artifacts. Unset = the committed
# defaults in games/spender/ai/models/. Normally leave these blank.
# SPENDER_WEIGHTS=
# SPENDER_AZ_MODEL=
# SPENDER_VALUE_MODEL=
